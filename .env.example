# Local development only. Copy to .env and replace all placeholders privately.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
POSTGRES_USER=voix_alumni_dev
POSTGRES_DB=voix_alumni_dev
POSTGRES_PASSWORD=
DATABASE_URL=
BETTER_AUTH_URL=http://127.0.0.1:5173
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lot 4: private development bucket and EU-jurisdiction S3 endpoint.
# Keep production values in its separate, untracked environment. No bucket is provisioned by the app.
# Endpoint form: https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Episodes 1–9 realized; 10 next and 11 planned are reserved. Import and reconcile before production use.
EPISODE_NUMBER_FLOOR=11
# Keep false until the owner has approved the complete real feedback notice and retention.
FEEDBACK_REAL_OPEN_APPROVED=false
FEEDBACK_PRIVACY_CONTROLLER=
FEEDBACK_PRIVACY_CONTACT=
FEEDBACK_PRIVACY_LEGAL_BASIS=
FEEDBACK_PRIVACY_HOSTING=
FEEDBACK_PRIVACY_NOTICE_URL=
