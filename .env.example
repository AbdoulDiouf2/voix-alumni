# Local development only. Copy to .env and replace all placeholders privately.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
POSTGRES_USER=voix_alumni_dev
POSTGRES_DB=voix_alumni_dev
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://voix_alumni_dev:replace-with-a-random-local-password@127.0.0.1:55432/voix_alumni_dev
BETTER_AUTH_URL=http://127.0.0.1:5173
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Future R2 EU jurisdiction endpoint; do not create buckets or credentials in Lot 0.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
