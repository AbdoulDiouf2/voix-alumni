{
  "name": "voix-alumni",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @voix-alumni/api",
    "dev:web": "npm run dev -w @voix-alumni/web",
    "dev:e2e:api": "node --env-file=.env.e2e --import tsx apps/api/src/server.ts",
    "dev:e2e:web": "VITE_API_PROXY_TARGET=http://127.0.0.1:8877 npm run dev -w @voix-alumni/web -- --port 5174 --strictPort",
    "e2e:prepare": "node --env-file=.env.e2e --import tsx apps/api/src/e2e-prepare.ts",
    "build": "npm run build -w @voix-alumni/contracts && npm run build -w @voix-alumni/db && npm run build -w @voix-alumni/api && npm run build -w @voix-alumni/web",
    "typecheck": "npm run build -w @voix-alumni/contracts && npm run build -w @voix-alumni/db && npm run typecheck -w @voix-alumni/api && npm run typecheck -w @voix-alumni/web",
    "lint": "eslint apps packages e2e playwright.config.ts",
    "format:check": "prettier --check 'apps/**/*.{ts,tsx,css,json,html}' 'packages/**/*.{ts,json}' 'e2e/**/*.ts' playwright.config.ts package.json eslint.config.mjs",
    "test": "npm run build -w @voix-alumni/contracts && npm run build -w @voix-alumni/db && npm run test -w @voix-alumni/api",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "auth": "1.7.12",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
